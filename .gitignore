# ─── Code Composer Studio (CCS) ───────────────────────────────────────────────

# Build output directories (fully regenerated by CCS)
Debug/
Release/

# CCS/Eclipse project metadata (machine-specific, not portable)
.ccsproject
.cproject
.project
.settings/
.theia/

# Clangd LSP index cache
.clangd
**/.clangd/

# Build artifacts
*.obj
*.out
*.map
*.d
*.opt
*.idx

# ─── GCC / Makefile build artifacts ──────────────────────────────────────────
build/
*.o
*.elf

# ─── Windows crash dumps ──────────────────────────────────────────────────────
*.stackdump
bash.exe.stackdump